{
  "manifest_version": 2,
  "name": "1337x OMDb Ratings",
  "description": "Adds IMDb and Rotten Tomatoes ratings to 1337x torrent tables using OMDb.",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "https://www.omdbapi.com/*",
    "https://1337x.to/*",
    "https://www.1337x.to/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://1337x.to/*",
        "https://www.1337x.to/*"
      ],
      "js": [
        "src/defaults.js",
        "src/omdb.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_title": "1337x OMDb Ratings Settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "1337x-omdb-ratings@example.com",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "109.0"
    }
  }
}
